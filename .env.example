HCA_CLIENT_ID=
HCA_CLIENT_SECRET=
HACKATIME_CLIENT_ID=
HACKATIME_CLIENT_SECRET=

DATABASE_URL=postgres://dyad:password@localhost:5432/dyad

AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE=

SLACK_BOT_TOKEN=

# true to accept requests that don't come straight from Cloudflare
ALLOW_NON_CLOUDFLARE=false

# 32 random bytes, base64: openssl rand -base64 32
TOKEN_KEY=
# the old TOKEN_KEY while rotating, blank otherwise
TOKEN_KEY_PREVIOUS=

# public URL for OAuth redirects, e.g. https://dyad.hackclub.com
BASE_URL=

# optional, defaults to info,sqlx::query=warn
# RUST_LOG=
